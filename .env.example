# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Admin ─────────────────────────────────────────────────────────────────────
# 12 caracteres minimum ; utiliser une valeur unique qui n'apparait jamais dans Git.
ADMIN_PASSWORD=exemple-uniquement-a-remplacer
# Génère-en une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=une-chaine-aleatoire-de-64-caracteres-minimum
# Incrémenter cette valeur révoque immédiatement toutes les sessions existantes.
ADMIN_SESSION_VERSION=1

# Secret distinct utilisé uniquement pour pseudonymiser les clés anti-abus.
RATE_LIMIT_SECRET=une-autre-chaine-aleatoire-de-64-caracteres-minimum
MARKETING_UNSUBSCRIBE_SECRET=une-troisieme-chaine-aleatoire-de-64-caracteres-minimum
# Laisser false sauf si un reverse proxy maîtrisé fournit x-forwarded-for.
TRUST_PROXY=false
# Source d'IP explicitement approuvée : none, vercel, cloudflare ou netlify.
# Cloudflare exige que l'origine refuse les connexions qui ne viennent pas de Cloudflare.
HOSTING_PLATFORM=none
# Délai minimal entre la demande et le début d'un RDV (0 à 10080 minutes).
BOOKING_MIN_LEAD_MINUTES=60

# ── Email (Resend) — https://resend.com — Gratuit : 3 000 emails/mois ─────────
RESEND_API_KEY=re_xxxxxxxxxxxx
# Domaine vérifié dans Resend (ex : phenoandco.fr)
EMAIL_FROM=PHENO&CO <noreply@phenoandco.fr>

# ── Email admin (destinataire des notifications) ──────────────────────────────
NEXT_PUBLIC_ADMIN_EMAIL=location.phenoandco@gmail.com

# ── Site URL (pour les liens dans les emails) ─────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://phenoandco.fr

# ── SMS (Twilio) — https://twilio.com — Payant : ~0.06 €/SMS ─────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numéro Twilio au format E.164 (ex : +33XXXXXXXXX)
TWILIO_FROM_NUMBER=+33XXXXXXXXX

# ── Cron secret (pour protéger /api/cron/reminders) ──────────────────────────
# Génère-en une : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=une-chaine-secrete-pour-le-cron

# ── EmailJS (contact form backup — optionnel si Resend est configuré) ─────────
NEXT_PUBLIC_EMAILJS_KEY=ta-cle-publique-emailjs
